{
  "name": "@wafflefinance/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for the WaffleFinance cross-chain bridge: Ethereum, Soroban, and Solana HTLC clients, a typed Coordinator API client, secret utilities, and a shared order state machine.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ethereum": {
      "types": "./dist/ethereum/index.d.ts",
      "import": "./dist/ethereum/index.js"
    },
    "./soroban": {
      "types": "./dist/soroban/index.d.ts",
      "import": "./dist/soroban/index.js"
    },
    "./secrets": {
      "types": "./dist/secrets/index.d.ts",
      "import": "./dist/secrets/index.js"
    },
    "./state-machine": {
      "types": "./dist/state-machine/index.d.ts",
      "import": "./dist/state-machine/index.js"
    },
    "./solana": {
      "types": "./dist/solana/index.d.ts",
      "import": "./dist/solana/index.js"
    },
    "./assets": {
      "types": "./dist/assets/index.d.ts",
      "import": "./dist/assets/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./routes": {
      "types": "./dist/routes/index.d.ts",
      "import": "./dist/routes/index.js"
    },
    "./routes/fee-policy": {
      "types": "./dist/routes/fee-policy.d.ts",
      "import": "./dist/routes/fee-policy.js"
    },
    "./config-validation": {
      "import": "./dist/config-validation.js",
      "types": "./dist/config-validation.d.ts"
    },
    "./htlc-client": {
      "types": "./dist/htlc-client.d.ts",
      "import": "./dist/htlc-client.js"
    },
    "./approval": {
      "types": "./dist/approval.d.ts",
      "import": "./dist/approval.js"
    },
    "./ethereum/adapter": {
      "types": "./dist/ethereum/adapter.d.ts",
      "import": "./dist/ethereum/adapter.js"
    },
    "./soroban/adapter": {
      "types": "./dist/soroban/adapter.d.ts",
      "import": "./dist/soroban/adapter.js"
    },
    "./soroban/orchestrator": {
      "types": "./dist/soroban/orchestrator.d.ts",
      "import": "./dist/soroban/orchestrator.js"
    },
    "./solana/adapter": {
      "types": "./dist/solana/adapter.d.ts",
      "import": "./dist/solana/adapter.js"
    },
    "./solana/rpc-provider": {
      "types": "./dist/solana/rpc-provider.d.ts",
      "import": "./dist/solana/rpc-provider.js"
    },
    "./solana/account-validation": {
      "types": "./dist/solana/account-validation.d.ts",
      "import": "./dist/solana/account-validation.js"
    },
    "./solana/wallet": {
      "types": "./dist/solana/wallet.d.ts",
      "import": "./dist/solana/wallet.js"
    },
    "./solana/idl": {
      "types": "./dist/solana/idl/htlc.d.ts",
      "import": "./dist/solana/idl/htlc.js"
    },
    "./internal/fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/fixtures/index.js"
    },
    "./coordinator": {
      "types": "./dist/coordinator/index.d.ts",
      "import": "./dist/coordinator/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:analyze": "tsc && npm run analyze",
    "analyze": "node scripts/analyze-bundle.js",
    "analyze:cost": "node scripts/measure-entry-cost.mjs",
    "analyze:cost:bundle": "node scripts/measure-entry-cost.mjs --bundle",
    "verify:subpaths": "node scripts/verify-subpath-isolation.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "@stellar/stellar-sdk": "^13.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
